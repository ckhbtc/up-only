# Hex EVM private key (no 0x prefix needed; ethers accepts both forms) for a
# limited-balance INJ wallet that will send 0.001 INJ to fresh wallets so they
# can pay gas for their first AuthZ grant. If unset, the faucet is a no-op -
# brand-new wallets will fail their first grant with "account not found" and
# have to fund themselves manually.
#
# Do not use a primary wallet here. Keep only the small float needed for the
# faucet and CCTP mint relayer.
FAUCET_PRIVATE_KEY=

# Faucet abuse controls. Production should keep only https://uponly.click in
# the origin allowlist. The reserve is never spent by the faucet endpoint, and
# the daily cap persists across process restarts.
FAUCET_ALLOWED_ORIGINS=https://uponly.click
FAUCET_IP_LIMIT=3
FAUCET_IP_WINDOW_MS=3600000
FAUCET_DAILY_LIMIT_INJ=0.1
FAUCET_MIN_RESERVE_INJ=5
FAUCET_STATE_FILE=.data/faucet-usage.json

# Optional comma-separated endpoint overrides for the RFQ broadcast relay.
# RFQ_BROADCAST_RPC_URLS=https://sentry.tm.injective.network
# RFQ_BROADCAST_LCD_URLS=https://sentry.lcd.injective.network

# Optional. Production listen port for server.js. Defaults to 36000.
# PORT=36000

# Optional. Dev API port for dev-server.js. Defaults to 36001.
# API_PORT=36001
